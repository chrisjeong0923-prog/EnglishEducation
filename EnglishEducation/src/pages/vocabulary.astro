---
import Layout from '../layouts/Layout.astro';
import Flashcard from '../components/Flashcard.astro';
import vocabularyData from '../data/vocabulary.json';

const grade3Words = vocabularyData.filter(word => word.grade === 3);
const grade4Words = vocabularyData.filter(word => word.grade === 4);
const grade5Words = vocabularyData.filter(word => word.grade === 5);
const grade6Words = vocabularyData.filter(word => word.grade === 6);
---

<Layout title="Bilingual Word Flashcards" description="Study English vocabulary words mapped by school grade. Mapped to 1st-4th grade English difficulty levels.">
  <div class="vocab-header">
    <h1 class="vocab-title">
      <span class="en-text">Fun Word Cards 📇</span>
      <span class="kh-text">កាតពាក្យសិក្សារីករាយ 📇</span>
    </h1>
    <p class="vocab-subtitle">
      <span class="en-text">Study the words for your grade! You can change your grade on the home page.</span>
      <span class="kh-text">សិក្សាពាក្យសម្រាប់ថ្នាក់របស់អ្នក! អ្នកអាចប្តូរថ្នាក់របស់អ្នកនៅលើទំព័រដើម។</span>
    </p>
  </div>

  <!-- Vocabulary Mastery Progress Bar -->
  <div class="vocab-progress-wrapper glass-card">
    <div class="vocab-progress-info">
      <h3 class="progress-title">
        <span class="en-text">Grade Word Mastery 🌟</span>
        <span class="kh-text">វឌ្ឍនភាពសិក្សាពាក្យ 🌟</span>
      </h3>
      <span class="vocab-count-badge">
        <span id="vocab-progress-num">0</span> / <span id="vocab-progress-total">0</span>
      </span>
    </div>
    <div class="vocab-progress-bar-bg">
      <div class="vocab-progress-bar-fill" id="vocab-progress-bar" style="width: 0%;"></div>
    </div>
  </div>

  <!-- Grade 3 Tab Panel -->
  <div class="tab-panel" id="grade3">
    <div class="cards-grid">
      {grade3Words.map(word => (
        <Flashcard {...word} />
      ))}
    </div>
  </div>

  <!-- Grade 4 Tab Panel -->
  <div class="tab-panel" id="grade4">
    <div class="cards-grid">
      {grade4Words.map(word => (
        <Flashcard {...word} />
      ))}
    </div>
  </div>

  <!-- Grade 5 Tab Panel -->
  <div class="tab-panel" id="grade5">
    <div class="cards-grid">
      {grade5Words.map(word => (
        <Flashcard {...word} />
      ))}
    </div>
  </div>

  <!-- Grade 6 Tab Panel -->
  <div class="tab-panel" id="grade6">
    <div class="cards-grid">
      {grade6Words.map(word => (
        <Flashcard {...word} />
      ))}
    </div>
  </div>
</Layout>

<script>
  import { profileManager } from '../scripts/profileManager';

  // Show active tab panel based on localStorage preference
  const preferredGrade = localStorage.getItem('preferredGrade') || 'grade3';
  const activePanel = document.getElementById(preferredGrade);
  if (activePanel) {
    activePanel.classList.add('active');
  } else {
    document.getElementById('grade3')?.classList.add('active');
  }

  // Populate learned buttons on startup
  function initLearnedButtons() {
    const profile = profileManager.getProfile();
    if (profile) {
      const learnedWords = profile.learnedWords || [];
      document.querySelectorAll('.learn-btn').forEach(btn => {
        const word = btn.getAttribute('data-word');
        if (word && learnedWords.includes(word)) {
          btn.classList.add('learned');
        }
      });
    }
  }

  // Dynamic Page Progress updater
  function updateVocabProgress() {
    const activeTab = document.querySelector('.tab-panel.active');
    const progressNum = document.getElementById('vocab-progress-num');
    const progressTotal = document.getElementById('vocab-progress-total');
    const progressBar = document.getElementById('vocab-progress-bar');
    
    if (!activeTab || !progressNum || !progressBar) return;

    // All flashcards in this active grade tab (selecting just front learn-btn to count unique words)
    const uniqueCards = activeTab.querySelectorAll('.card-front .learn-btn');
    const totalWords = uniqueCards.length || 1;
    
    if (progressTotal) {
      progressTotal.innerText = totalWords.toString();
    }
    
    let learnedCount = 0;
    uniqueCards.forEach(btn => {
      if (btn.classList.contains('learned')) {
        learnedCount++;
      }
    });

    progressNum.innerText = learnedCount.toString();
    const pct = Math.min(100, Math.round((learnedCount / totalWords) * 100));
    progressBar.style.width = `${pct}%`;
  }

  // Event delegation for marking words learned
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.learn-btn');
    if (!btn) return;
    
    e.stopPropagation();
    const word = btn.getAttribute('data-word');
    if (!word) return;

    const profile = profileManager.getProfile();
    if (!profile) {
      const isEn = !document.documentElement.classList.contains('lang-khmer');
      const alertMsg = isEn 
        ? "Please create a profile first to save your word progress! Click 'Join Academy' in the menu."
        : "សូមបង្កើតគណនីដំបូង ដើម្បីរក្សាទុកវឌ្ឍនភាពសិក្សារបស់អ្នក! ចុច 'ចុះឈ្មោះរៀន' នៅក្នុងម៉ឺនុយខាងលើ។";
      alert(alertMsg);
      return;
    }

    const isCurrentlyLearned = btn.classList.contains('learned');
    
    if (isCurrentlyLearned) {
      profileManager.unmarkWordAsLearned(word);
    } else {
      profileManager.markWordAsLearned(word);
    }

    // Toggle class on all buttons of this word (front and back of card)
    document.querySelectorAll(`.learn-btn[data-word="${word}"]`).forEach(el => {
      el.classList.toggle('learned', !isCurrentlyLearned);
    });

    // Update gauge
    updateVocabProgress();
  });

  // Run on startup
  initLearnedButtons();
  updateVocabProgress();
</script>

<style>
  .vocab-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .vocab-title {
    font-size: 2.6rem;
    margin-bottom: 8px;
    color: #1a202c;
  }

  .vocab-subtitle {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    font-weight: 600;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Panels Grid */
  .tab-panel {
    display: none;
    animation: fadeIn 0.4s ease-out;
  }

  .tab-panel.active {
    display: block;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    padding-bottom: 40px;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Progress Card Styles */
  .vocab-progress-wrapper {
    max-width: 600px;
    margin: -10px auto 40px auto;
    padding: 20px 24px;
    background: #ffffff;
    border-color: rgba(167, 139, 250, 0.3);
    box-shadow: var(--shadow-playful);
    border-radius: var(--radius-lg);
  }

  .vocab-progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .progress-title {
    font-size: 1.15rem;
    font-weight: 900;
    color: #1a202c;
  }

  .vocab-count-badge {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--color-primary);
    background: #f3e8ff;
    padding: 2px 12px;
    border-radius: 12px;
    border: 2px solid rgba(159, 122, 234, 0.2);
  }

  .vocab-progress-bar-bg {
    width: 100%;
    height: 12px;
    background: #f1f5f9;
    border-radius: 6px;
    border: 2px solid #e2e8f0;
    overflow: hidden;
  }

  .vocab-progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
    width: 0%;
    border-radius: 6px;
    transition: width 0.5s ease;
  }
</style>
