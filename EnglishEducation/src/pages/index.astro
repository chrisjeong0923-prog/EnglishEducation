---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Fun English Learning for Kids" description="Interactive word games, reading cards, and fun quizzes for kids from 1st to 4th grade, localized for Cambodian learners." theme="yellow">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <!-- Welcome Profile Banner -->
      <div id="welcome-profile-banner" class="welcome-profile-banner hidden"></div>

      <h1 class="hero-title">
        <span class="en-text-block">Learn English with <br/><span class="text-glow">Fun Games! 🎈</span></span>
        <span class="kh-text-block">រៀនភាសាអង់គ្លេសជាមួយ <br/><span class="text-glow">ល្បែងកម្សាន្តសប្បាយៗ! 🎈</span></span>
      </h1>
      
      <p class="hero-subtitle">
        <span class="en-text-block">Welcome to Kids English Academy! Explore our fun word cards, play cool grammar quizzes, and practice listening to happy stories. Let's start our learning adventure today! 🌟</span>
        <span class="kh-text-block">សូមស្វាគមន៍មកកាន់វិទ្យាស្ថានភាសាអង់គ្លេសកុមារ! ស្វែងយល់ពីកាតពាក្យសិក្សាដ៏រីករាយ លេងល្បែងតេស្តសាកល្បងវេយ្យាករណ៍ និងហ្វឹកហាត់ស្តាប់រឿងរ៉ាវគួរឱ្យស្រឡាញ់។ តោះចាប់ផ្តើមការផ្សងព្រេងថ្ងៃនេះ! 🌟</span>
      </p>
      
      <div class="hero-actions">
        <a href={`${baseUrl}vocabulary`} class="btn btn-primary">
          <span class="en-text">Start Learning! 🚀</span>
          <span class="kh-text">ចាប់ផ្តើមរៀន! 🚀</span>
        </a>
        <a href="#paths" class="btn btn-secondary">
          <span class="en-text">See Games 🎮</span>
          <span class="kh-text">មើលល្បែងកម្សាន្ត 🎮</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Grade Level Selector Section -->
  <section class="grade-selection-section glass-card">
    <h2 class="grade-section-title">
      <span class="en-text">Select Your School Grade 🌟</span>
      <span class="kh-text">ជ្រើសរើសថ្នាក់រៀនរបស់អ្នក 🌟</span>
    </h2>
    <p class="grade-section-subtitle">
      <span class="en-text">Pick your grade below. The lessons and quizzes will automatically open at your level!</span>
      <span class="kh-text">ជ្រើសរើសថ្នាក់របស់អ្នកខាងក្រោម។ មេរៀន និងតេស្តសាកល្បងទាំងអស់នឹងបង្ហាញកម្រិតដែលត្រូវនឹងថ្នាក់របស់អ្នកដោយស្វ័យប្រវត្ត!</span>
    </p>
    <div class="grade-bubbles">
      <button class="grade-bubble-btn" data-grade="grade3">
        <span class="bubble-title">
          <span class="en-text">Grade 3</span>
          <span class="kh-text">ថ្នាក់ទី ៣</span>
        </span>
        <span class="bubble-sub">
          <span class="en-text">Level 1 English</span>
          <span class="kh-text">កម្រិត ១ (ងាយ)</span>
        </span>
      </button>
      
      <button class="grade-bubble-btn" data-grade="grade4">
        <span class="bubble-title">
          <span class="en-text">Grade 4</span>
          <span class="kh-text">ថ្នាក់ទី ៤</span>
        </span>
        <span class="bubble-sub">
          <span class="en-text">Level 2 English</span>
          <span class="kh-text">កម្រិត ២ (មធ្យម)</span>
        </span>
      </button>
      
      <button class="grade-bubble-btn" data-grade="grade5">
        <span class="bubble-title">
          <span class="en-text">Grade 5</span>
          <span class="kh-text">ថ្នាក់ទី ៥</span>
        </span>
        <span class="bubble-sub">
          <span class="en-text">Level 3 English</span>
          <span class="kh-text">កម្រិត ៣ (ពិបាក)</span>
        </span>
      </button>
      
      <button class="grade-bubble-btn" data-grade="grade6">
        <span class="bubble-title">
          <span class="en-text">Grade 6</span>
          <span class="kh-text">ថ្នាក់ទី ៦</span>
        </span>
        <span class="bubble-sub">
          <span class="en-text">Level 4 English</span>
          <span class="kh-text">កម្រិត ៤ (ពិបាកខ្លាំង)</span>
        </span>
      </button>
    </div>
  </section>

  <!-- Learning Paths Section -->
  <section id="paths" class="paths-section">
    <h2 class="section-title">
      <span class="en-text">Pick Your Learning Game</span>
      <span class="kh-text">ជ្រើសរើសល្បែងសិក្សារបស់អ្នក</span>
    </h2>
    <p class="section-subtitle">
      <span class="en-text">Choose one of the fun sections below to practice your English!</span>
      <span class="kh-text">ជ្រើសរើសផ្នែកដ៏រីករាយណាមួយខាងក្រោម ដើម្បីអនុវត្តភាសាអង់គ្លេសរបស់អ្នក!</span>
    </p>
    
    <div class="paths-grid">
      <!-- Vocabulary Card -->
      <div class="path-card glass-card">
        <div class="card-icon-wrapper purple">
          <span>🎨</span>
        </div>
        <h3 class="path-title">
          <span class="en-text">Fun Word Cards</span>
          <span class="kh-text">កាតពាក្យសិក្សា</span>
        </h3>
        <p class="path-desc">
          <span class="en-text">Learn daily words with colorful cards! Tap the card to flip it and see what the word means. Click the speaker to hear how it sounds! 🔊</span>
          <span class="kh-text">រៀនពាក្យប្រចាំថ្ងៃជាមួយកាតចម្រុះពណ៌! ចុចលើកាតដើម្បីផ្ងារមើលន័យពាក្យ។ ចុចលើរូបបំពងសំឡេងដើម្បីស្តាប់ការបញ្ចេញសំឡេង! 🔊</span>
        </p>
        <a href={`${baseUrl}vocabulary`} class="path-link">
          <span class="en-text">Play Word Cards &rarr;</span>
          <span class="kh-text">លេងកាតពាក្យសិក្សា &rarr;</span>
        </a>
      </div>

      <!-- Grammar Quiz Card -->
      <div class="path-card glass-card">
        <div class="card-icon-wrapper yellow">
          <span>⭐</span>
        </div>
        <h3 class="path-title">
          <span class="en-text">Cool Quiz Games</span>
          <span class="kh-text">តេស្តសាកល្បង</span>
        </h3>
        <p class="path-desc">
          <span class="en-text">Answer questions and collect stars! Check your answers to see explanations that make grammar easy to learn! ✏️</span>
          <span class="kh-text">ឆ្លើយសំណួរផ្សេងៗ និងប្រមូលផ្កាយ! ពិនិត្យមើលចម្លើយរបស់អ្នក ដើម្បីមើលការពន្យល់ដែលជួយឱ្យវេយ្យាករណ៍កាន់តែងាយយល់! ✏️</span>
        </p>
        <a href={`${baseUrl}quiz`} class="path-link">
          <span class="en-text">Play Quiz Games &rarr;</span>
          <span class="kh-text">លេងតេស្តសាកល្បង &rarr;</span>
        </a>
      </div>

      <!-- Listening Dictation Card -->
      <div class="path-card glass-card">
        <div class="card-icon-wrapper blue">
          <span>🎧</span>
        </div>
        <h3 class="path-title">
          <span class="en-text">Listen & Write</span>
          <span class="kh-text">ស្តាប់ និងសរសេរ</span>
        </h3>
        <p class="path-desc">
          <span class="en-text">Listen to sweet voice recordings! Choose slow or normal speed, type what you hear in the box, and find out if you got it right! 📝</span>
          <span class="kh-text">ស្តាប់សំឡេងអានដ៏ពីរោះ! ជ្រើសរើសល្បឿនយឺត ឬធម្មតា វាយបញ្ចូលអ្វីដែលអ្នកបានឮនៅក្នុងប្រអប់ ហើយផ្ទៀងផ្ទាត់ចម្លើយរបស់អ្នក! 📝</span>
        </p>
        <a href={`${baseUrl}listening`} class="path-link">
          <span class="en-text">Practice Listening &rarr;</span>
          <span class="kh-text">ហ្វឹកហាត់ការស្តាប់ &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Features Spotlight -->
  <section class="features-spotlight glass-card">
    <div class="spotlight-content">
      <h2 class="spotlight-title">
        <span class="en-text">Voices Built Right In! 🗣️</span>
        <span class="kh-text">មានសំឡេងអានមកជាមួយស្រាប់! 🗣️</span>
      </h2>
      <p class="spotlight-desc">
        <span class="en-text">Our game uses your web browser's friendly speaking voice to read words aloud. This means you don't have to wait for large audio files to download. You can practice as much as you like, anytime, anywhere!</span>
        <span class="kh-text">កម្មវិធីសិក្សារបស់យើងប្រើប្រាស់បច្ចេកវិទ្យាបញ្ចេញសំឡេងស្វ័យប្រវត្តិនៃកម្មវិធីរុករកវិបសាយរបស់អ្នក ដើម្បីអានពាក្យខ្លាំងៗ។ នេះមានន័យថាអ្នកមិនចាំបាច់រង់ចាំទាញយកឯកសារសំឡេងធំៗនោះទេ។ អ្នកអាចហ្វឹកហាត់បានច្រើនតាមចិត្ត ចង់រៀនពេលណាក៏បាន ទីណាក៏បាន!</span>
      </p>
      <div class="tech-tags">
        <span class="tech-tag">
          <span class="en-text">⭐ Kid-Friendly Design</span>
          <span class="kh-text">⭐ រចនាឡើងសមរម្យសម្រាប់កុមារ</span>
        </span>
        <span class="tech-tag">
          <span class="en-text">🔊 Sound Pronunciation</span>
          <span class="kh-text">🔊 ការបញ្ចេញសំឡេងច្បាស់ៗ</span>
        </span>
        <span class="tech-tag">
          <span class="en-text">💻 Play on Tablets & PCs</span>
          <span class="kh-text">💻 ដំណើរការលើ Tablet និងកុំព្យូទ័រ</span>
        </span>
      </div>
    </div>
  </section>

  <!-- Registration Modal Overlay -->
  <div id="register-modal-overlay" class="modal-overlay hidden">
    <div class="modal-card glass-card">
      
      <!-- VIEW A: PROFILE SWITCHER VIEW -->
      <div id="modal-view-switcher" class="modal-view hidden">
        <div class="modal-header">
          <span class="modal-balloon">🎈</span>
          <h2 class="modal-title">
            <span class="en-text">Who is learning today?</span>
            <span class="kh-text">តើអ្នកណានឹងរៀនថ្ងៃនេះ?</span>
          </h2>
          <p class="modal-subtitle">
            <span class="en-text">Select your profile to continue your learning adventure!</span>
            <span class="kh-text">ជ្រើសរើសគណនីរបស់អ្នក ដើម្បីបន្តដំណើរផ្សងព្រេងសិក្សា!</span>
          </p>
        </div>
        
        <!-- Grid for profile choices -->
        <div class="modal-profile-picker-grid" id="modal-profile-list">
          <!-- Injected dynamically -->
        </div>

        <div class="modal-actions-switcher">
          <button type="button" id="btn-modal-go-create" class="btn btn-primary">
            <span class="en-text">+ Add Profile</span>
            <span class="kh-text">+ បង្កើតគណនី</span>
          </button>
          <button type="button" id="btn-modal-skip-switcher" class="btn btn-secondary">
            <span class="en-text">Skip</span>
            <span class="kh-text">រំលង</span>
          </button>
        </div>
      </div>

      <!-- VIEW B: PROFILE CREATION VIEW -->
      <div id="modal-view-create" class="modal-view">
        <div class="modal-header">
          <span class="modal-balloon">✨</span>
          <h2 class="modal-title">
            <span class="en-text">Create Your Profile!</span>
            <span class="kh-text">បង្កើតគណនីរបស់អ្នក!</span>
          </h2>
          <p class="modal-subtitle">
            <span class="en-text">Save your English stars and earn cool animal badges!</span>
            <span class="kh-text">សន្សំផ្កាយភាសាអង់គ្លេស និងទទួលបានមេដាយសត្វស្អាតៗ!</span>
          </p>
        </div>

        <form id="modal-register-form" class="playful-form">
          <!-- Avatar Selection -->
          <div class="form-group">
            <label class="form-label">
              <span class="en-text">Choose Your Companion:</span>
              <span class="kh-text">ជ្រើសរើសមិត្តសត្វរបស់អ្នក៖</span>
            </label>
            <div class="modal-avatar-grid">
              <label class="avatar-label-modal">
                <input type="radio" name="modal-avatar" value="🐼" checked />
                <span class="modal-avatar-emoji">🐼</span>
              </label>
              <label class="avatar-label-modal">
                <input type="radio" name="modal-avatar" value="🦁" />
                <span class="modal-avatar-emoji">🦁</span>
              </label>
              <label class="avatar-label-modal">
                <input type="radio" name="modal-avatar" value="🦊" />
                <span class="modal-avatar-emoji">🦊</span>
              </label>
              <label class="avatar-label-modal">
                <input type="radio" name="modal-avatar" value="🐨" />
                <span class="modal-avatar-emoji">🐨</span>
              </label>
              <label class="avatar-label-modal">
                <input type="radio" name="modal-avatar" value="🐰" />
                <span class="modal-avatar-emoji">🐰</span>
              </label>
              <label class="avatar-label-modal">
                <input type="radio" name="modal-avatar" value="🐸" />
                <span class="modal-avatar-emoji">🐸</span>
              </label>
            </div>
          </div>

          <!-- Nickname Input -->
          <div class="form-group">
            <label for="modal-nickname" class="form-label">
              <span class="en-text">Nickname:</span>
              <span class="kh-text">ឈ្មោះហៅក្រៅ៖</span>
            </label>
            <input 
              type="text" 
              id="modal-nickname" 
              placeholder="Type your name here..." 
              maxlength="15" 
              required 
              class="playful-input"
            />
          </div>

          <!-- Grade Selection -->
          <div class="form-group">
            <label for="modal-grade" class="form-label">
              <span class="en-text">School Grade:</span>
              <span class="kh-text">ថ្នាក់រៀន៖</span>
            </label>
            <select id="modal-grade" class="playful-select">
              <option value="grade3">Grade 3 / ថ្នាក់ទី ៣</option>
              <option value="grade4">Grade 4 / ថ្នាក់ទី ៤</option>
              <option value="grade5">Grade 5 / ថ្នាក់ទី ៥</option>
              <option value="grade6">Grade 6 / ថ្នាក់ទី ៦</option>
            </select>
          </div>

          <div class="modal-actions">
            <button type="submit" class="btn btn-primary">
              <span class="en-text">Let's Go! 🚀</span>
              <span class="kh-text">តោះរៀន! 🚀</span>
            </button>
            <button type="button" id="btn-modal-back-switcher" class="btn btn-secondary hidden">
              <span class="en-text">Back</span>
              <span class="kh-text">ត្រឡប់ក្រោយ</span>
            </button>
            <button type="button" id="btn-modal-skip" class="btn btn-secondary">
              <span class="en-text">Skip</span>
              <span class="kh-text">រំលងសិន</span>
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { profileManager } from '../scripts/profileManager';

  const gradeButtons = document.querySelectorAll('.grade-bubble-btn');
  const registerModal = document.getElementById('register-modal-overlay');
  const modalForm = document.getElementById('modal-register-form') as HTMLFormElement;
  const skipBtn = document.getElementById('btn-modal-skip');
  const welcomeBanner = document.getElementById('welcome-profile-banner');
  
  // Views & toggle buttons
  const viewSwitcher = document.getElementById('modal-view-switcher');
  const viewCreate = document.getElementById('modal-view-create');
  const goCreateBtn = document.getElementById('btn-modal-go-create');
  const backToSwitcherBtn = document.getElementById('btn-modal-back-switcher');
  const skipSwitcherBtn = document.getElementById('btn-modal-skip-switcher');

  // Read and apply active profile
  let currentGrade = 'grade3';
  const activeProfile = profileManager.getProfile();
  
  if (activeProfile) {
    currentGrade = activeProfile.grade;
    if (welcomeBanner) {
      welcomeBanner.innerHTML = `
        <span class="en-text">🌟 Welcome back, ${activeProfile.avatar} ${activeProfile.nickname}! Ready to learn? <a href="#" id="welcome-switch-user" class="switch-link">Switch User 🔄</a></span>
        <span class="kh-text">🌟 ស្វាគមន៍ត្រឡប់មកវិញ, ${activeProfile.avatar} ${activeProfile.nickname}! តោះចាប់ផ្តើមរៀន? <a href="#" id="welcome-switch-user-kh" class="switch-link">ប្តូរគណនី 🔄</a></span>
      `;
      welcomeBanner.classList.remove('hidden');

      // Bind switcher links on homepage banner
      document.querySelectorAll('.switch-link').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          showProfilePrompt();
        });
      });
    }
  } else {
    currentGrade = localStorage.getItem('preferredGrade') || 'grade3';
    // Trigger modal if not logged in and not skipped
    const isSkipped = localStorage.getItem('profilePromptSkipped') === 'true';
    if (!isSkipped && registerModal) {
      setTimeout(() => {
        showProfilePrompt();
      }, 800);
    }
  }

  // Helper to trigger and render the switcher/creator modal
  function showProfilePrompt() {
    if (!registerModal) return;
    const profiles = profileManager.getProfilesList();
    
    if (profiles.length > 0) {
      // Show Switcher View
      viewCreate?.classList.add('hidden');
      viewSwitcher?.classList.remove('hidden');
      backToSwitcherBtn?.classList.remove('hidden');
      
      const listEl = document.getElementById('modal-profile-list');
      if (listEl) {
        listEl.innerHTML = '';
        profiles.forEach(p => {
          const stars = profileManager.calculateStars(p);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'modal-profile-card';
          btn.innerHTML = `
            <div class="modal-profile-avatar">${p.avatar}</div>
            <div class="modal-profile-info">
              <div class="modal-profile-name">${p.nickname}</div>
              <div class="modal-profile-stars">⭐ ${stars} Stars</div>
            </div>
          `;
          btn.addEventListener('click', () => {
            profileManager.setActiveProfile(p.id);
            registerModal.classList.add('hidden');
            location.reload();
          });
          listEl.appendChild(btn);
        });
      }
    } else {
      // Show Creation View directly
      viewSwitcher?.classList.add('hidden');
      viewCreate?.classList.remove('hidden');
      backToSwitcherBtn?.classList.add('hidden');
    }

    registerModal.classList.remove('hidden');
  }

  // Bind Switcher sub-actions
  goCreateBtn?.addEventListener('click', () => {
    viewSwitcher?.classList.add('hidden');
    viewCreate?.classList.remove('hidden');
  });

  backToSwitcherBtn?.addEventListener('click', () => {
    viewCreate?.classList.add('hidden');
    viewSwitcher?.classList.remove('hidden');
  });

  const activeBtn = document.querySelector(`.grade-bubble-btn[data-grade="${currentGrade}"]`);
  if (activeBtn) {
    activeBtn.classList.add('selected');
  }

  // Handle homepage grade button select
  gradeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      gradeButtons.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      
      const grade = btn.getAttribute('data-grade');
      if (grade) {
        localStorage.setItem('preferredGrade', grade);
        const profile = profileManager.getProfile();
        if (profile) {
          profile.grade = grade;
          profileManager.saveProfile(profile);
        }
      }
    });
  });

  // Modal Registration submit handler
  if (modalForm) {
    modalForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const nicknameEl = document.getElementById('modal-nickname') as HTMLInputElement;
      const gradeEl = document.getElementById('modal-grade') as HTMLSelectElement;
      const avatarEl = document.querySelector('input[name="modal-avatar"]:checked') as HTMLInputElement;

      if (nicknameEl && gradeEl && avatarEl) {
        profileManager.createProfile(nicknameEl.value, avatarEl.value, gradeEl.value);
        registerModal?.classList.add('hidden');
        location.reload();
      }
    });
  }

  // Modal skip button handlers
  const handleSkip = () => {
    localStorage.setItem('profilePromptSkipped', 'true');
    registerModal?.classList.add('hidden');
  };

  skipBtn?.addEventListener('click', handleSkip);
  skipSwitcherBtn?.addEventListener('click', handleSkip);
</script>

