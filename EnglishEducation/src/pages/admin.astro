---
import { createHash } from 'crypto';
import Layout from '../layouts/Layout.astro';
import vocabularyData from '../data/vocabulary.json';
import quizzesData from '../data/quizzes.json';
import listeningData from '../data/listening.json';
import lessonsData from '../data/lessons.json';

const rawPassword = process.env.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD || 'english123';
const targetHash = createHash('sha256').update(rawPassword).digest('hex');

const initialVocabulary = JSON.stringify(vocabularyData);
const initialQuizzes = JSON.stringify(quizzesData);
const initialListening = JSON.stringify(listeningData);
const initialLessons = JSON.stringify(lessonsData);
---

<Layout title="CMS Content Dashboard" description="Browse vocabulary words, quizzes, listening exercises, and lessons for Kids English Academy.">
  
  <!-- Gorgeous Admin Login Card (Visible by default until logged in) -->
  <div class="login-container glass-card" id="admin-login-card">
    <div class="login-header">
      <div class="lock-circle">🔒</div>
      <h2>CMS Portal Login</h2>
      <p>Please enter the administrator password to access the CMS explorer.</p>
    </div>
    <form class="login-form" id="login-form">
      <div class="form-group">
        <label for="admin-password">Administrator Password</label>
        <input type="password" id="admin-password" placeholder="••••••••" required />
      </div>
      <p class="error-msg hidden" id="login-error">❌ Invalid password! Access denied.</p>
      <button type="submit" class="btn btn-primary login-btn">Sign In ➔</button>
    </form>
  </div>

  <!-- Admin CMS Dashboard (Hidden by default until verified) -->
  <div class="admin-container hidden" 
       id="admin-dashboard-container"
       data-vocab={initialVocabulary} 
       data-quizzes={initialQuizzes} 
       data-listening={initialListening} 
       data-lessons={initialLessons}>
    
    <div class="admin-header">
      <div class="header-main">
        <h1 class="page-title">📊 CMS Content Explorer</h1>
        <p class="page-subtitle">A read-only view of the educational materials generated by your local Python script.</p>
      </div>
      <button class="btn btn-secondary" id="btn-admin-logout">Sign Out 🚪</button>
    </div>

    <!-- GitHub Pages Deployment Status (Read-only status monitor) -->
    <div class="deploy-status-card glass-card" id="deploy-status-card">
      <div class="deploy-header">
        <div class="header-left">
          <h3>🚀 Live Deployment Monitor</h3>
          <p class="deploy-meta">Polling latest GitHub Actions workflow runs for <code id="repo-label">chrisjeong0923-prog/EnglishEducation</code></p>
        </div>
        <span class="status-indicator checking" id="deploy-status-label">Checking...</span>
      </div>
      <div class="deploy-body">
        <p id="deploy-status-desc">Fetching status from GitHub Actions API...</p>
        <div class="progress-bar-bg">
          <div class="progress-bar-fill" id="deploy-progress-fill" style="width: 15%;"></div>
        </div>
      </div>
      <div class="deploy-settings-drawer">
        <details>
          <summary>⚙️ Change repository targets</summary>
          <div class="settings-grid">
            <div class="form-group">
              <label for="github-repo">Repository (username/repo)</label>
              <input type="text" id="github-repo" value="chrisjeong0923-prog/EnglishEducation" />
            </div>
            <div class="form-group">
              <label for="github-branch">Branch</label>
              <input type="text" id="github-branch" value="main" />
            </div>
            <button class="btn btn-secondary" id="btn-save-repo">Save & Refresh</button>
          </div>
        </details>
      </div>
    </div>

    <!-- Content Tabs -->
    <div class="tabs-container">
      <div class="tabs-list">
        <button class="tab-trigger" data-tab="words">📇 Vocabulary ({vocabularyData.length})</button>
        <button class="tab-trigger" data-tab="quizzes">✏️ Quizzes ({quizzesData.length})</button>
        <button class="tab-trigger" data-tab="listening">🎧 Listening Game ({listeningData.length})</button>
        <button class="tab-trigger active" data-tab="lessons">📖 Lessons ({lessonsData.length})</button>
      </div>

      <!-- Content Panels -->
      <div class="tab-panels-wrapper">
        
        <!-- Vocabulary Panel -->
        <div class="tab-content" id="tab-panel-words">
          <div class="panel-header-actions">
            <div class="filter-controls">
              <input type="text" placeholder="Search words..." class="search-input" id="search-words" />
              <select class="filter-select" id="filter-words-grade">
                <option value="all">All Grades</option>
                <option value="3">Grade 3</option>
                <option value="4">Grade 4</option>
                <option value="5">Grade 5</option>
                <option value="6">Grade 6</option>
              </select>
            </div>
          </div>
          <div class="table-container">
            <table class="cms-table">
              <thead>
                <tr>
                  <th>Grade</th>
                  <th>Word</th>
                  <th>Type</th>
                  <th>IPA</th>
                  <th>Emoji</th>
                  <th>Definition (EN / KH)</th>
                  <th>Example (EN / KH)</th>
                </tr>
              </thead>
              <tbody id="table-body-words"></tbody>
            </table>
          </div>
        </div>

        <!-- Quizzes Panel -->
        <div class="tab-content" id="tab-panel-quizzes">
          <div class="panel-header-actions">
            <div class="filter-controls">
              <input type="text" placeholder="Search questions..." class="search-input" id="search-quizzes" />
              <select class="filter-select" id="filter-quizzes-grade">
                <option value="all">All Grades</option>
                <option value="3">Grade 3</option>
                <option value="4">Grade 4</option>
                <option value="5">Grade 5</option>
                <option value="6">Grade 6</option>
              </select>
              <select class="filter-select" id="filter-quizzes-type">
                <option value="all">All Types</option>
                <option value="grammar">Grammar</option>
                <option value="vocabulary">Vocabulary</option>
              </select>
            </div>
          </div>
          <div class="table-container">
            <table class="cms-table">
              <thead>
                <tr>
                  <th>Grade</th>
                  <th>Type</th>
                  <th>Question Text</th>
                  <th>Options</th>
                  <th>Correct</th>
                  <th>Explanation</th>
                </tr>
              </thead>
              <tbody id="table-body-quizzes"></tbody>
            </table>
          </div>
        </div>

        <!-- Listening Panel -->
        <div class="tab-content" id="tab-panel-listening">
          <div class="panel-header-actions">
            <div class="filter-controls">
              <input type="text" placeholder="Search exercises..." class="search-input" id="search-listening" />
              <select class="filter-select" id="filter-listening-grade">
                <option value="all">All Levels</option>
                <option value="Level 1">Level 1 (Grade 3)</option>
                <option value="Level 2">Level 2 (Grade 4)</option>
                <option value="Level 3">Level 3 (Grade 5)</option>
                <option value="Level 4">Level 4 (Grade 6)</option>
              </select>
            </div>
          </div>
          <div class="table-container">
            <table class="cms-table">
              <thead>
                <tr>
                  <th>Level</th>
                  <th>Title (EN / KH)</th>
                  <th>Sentence Text</th>
                  <th>Clue Hint</th>
                </tr>
              </thead>
              <tbody id="table-body-listening"></tbody>
            </table>
          </div>
        </div>

        <!-- Lessons Panel -->
        <div class="tab-content active" id="tab-panel-lessons">
          <div class="panel-header-actions">
            <div class="filter-controls">
              <input type="text" placeholder="Search lessons..." class="search-input" id="search-lessons" />
              <select class="filter-select" id="filter-lessons-grade">
                <option value="all">All Grades</option>
                <option value="3">Grade 3</option>
                <option value="4">Grade 4</option>
                <option value="5">Grade 5</option>
                <option value="6">Grade 6</option>
              </select>
            </div>
          </div>
          <div class="table-container">
            <table class="cms-table">
              <thead>
                <tr>
                  <th>Grade</th>
                  <th>Slug ID</th>
                  <th>Title (EN / KH)</th>
                  <th>PDF Url</th>
                </tr>
              </thead>
              <tbody id="table-body-lessons"></tbody>
            </table>
          </div>
        </div>

      </div>
    </div>

  </div>
</Layout>

<script define:vars={{ targetHash }}>
  // Content models
  let vocab = [];
  let quizzes = [];
  let listening = [];
  let lessons = [];

  let activeTab = 'lessons';
  let gitRepo = 'chrisjeong0923-prog/EnglishEducation';
  let gitBranch = 'main';

  // Target password hash (passed from compile-time environment)
  const TARGET_HASH = targetHash;

  // DOM elements for Auth (declared globally, initialized in init)
  let loginCard;
  let loginForm;
  let loginPassword;
  let loginError;
  let dashboardContainer;
  let btnAdminLogout;

  // DOM for tabs & filters (declared globally, initialized in init)
  let tabTriggers;
  let tabContents;
  let inputRepo;
  let inputBranch;
  let repoLabel;
  let btnSaveRepo;

  let deployStatusLabel;
  let deployStatusDesc;
  let deployProgressFill;

  // Fallback SHA-256 implementation if crypto.subtle is unavailable (e.g. non-localhost HTTP)
  function sha256Fallback(ascii) {
    function rightRotate(value, amount) {
      return (value >>> amount) | (value << (32 - amount));
    }
    const mathPow = Math.pow;
    const maxWord = mathPow(2, 32);
    let result = '';
    const words = [];
    const asciiLength = ascii.length * 8;
    const hash = sha256Fallback.h = sha256Fallback.h || [];
    const k = sha256Fallback.k = sha256Fallback.k || [];
    let primeCounter = k.length;
    const isPrime = {};
    for (let candidate = 2; primeCounter < 64; candidate++) {
      if (!isPrime[candidate]) {
        for (let i = 0; i < 313; i += candidate) {
          isPrime[i] = 1;
        }
        hash[primeCounter] = (mathPow(candidate, .5) * maxWord) | 0;
        k[primeCounter++] = (mathPow(candidate, 1 / 3) * maxWord) | 0;
      }
    }
    ascii += '\x80';
    while (ascii.length % 64 - 56) ascii += '\x00';
    for (let i = 0; i < ascii.length; i++) {
      const j = ascii.charCodeAt(i);
      words[i >> 2] |= j << ((3 - i % 4) * 8);
    }
    words[words.length] = ((asciiLength / maxWord) | 0);
    words[words.length] = (asciiLength | 0);
    const H = hash.slice(0);
    for (let chunkStart = 0; chunkStart < words.length; chunkStart += 16) {
      const w_temp = words.slice(chunkStart, chunkStart + 16);
      for (let i = 16; i < 64; i++) {
        const s0 = rightRotate(w_temp[i - 15], 7) ^ rightRotate(w_temp[i - 15], 18) ^ (w_temp[i - 15] >>> 3);
        const s1 = rightRotate(w_temp[i - 2], 17) ^ rightRotate(w_temp[i - 2], 19) ^ (w_temp[i - 2] >>> 10);
        w_temp[i] = (w_temp[i - 16] + s0 + w_temp[i - 7] + s1) | 0;
      }
      let a = H[0], b = H[1], c = H[2], d = H[3], e = H[4], f = H[5], g = H[6], h = H[7];
      for (let i = 0; i < 64; i++) {
        const S1 = rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25);
        const ch = (e & f) ^ (~e & g);
        const temp1 = (h + S1 + ch + k[i] + w_temp[i]) | 0;
        const S0 = rightRotate(a, 2) ^ rightRotate(a, 13) ^ rightRotate(a, 22);
        const maj = (a & b) ^ (a & c) ^ (b & c);
        const temp2 = (S0 + maj) | 0;
        h = g; g = f; f = e; e = (d + temp1) | 0; d = c; c = b; b = a; a = (temp1 + temp2) | 0;
      }
      H[0] = (H[0] + a) | 0; H[1] = (H[1] + b) | 0; H[2] = (H[2] + c) | 0; H[3] = (H[3] + d) | 0;
      H[4] = (H[4] + e) | 0; H[5] = (H[5] + f) | 0; H[6] = (H[6] + g) | 0; H[7] = (H[7] + h) | 0;
    }
    for (let i = 0; i < 8; i++) {
      const hex = (H[i] >>> 0).toString(16);
      result += ('00000000' + hex).slice(-8);
    }
    return result;
  }

  // SHA-256 tool with fallback support
  async function sha256(message) {
    if (typeof crypto !== 'undefined' && crypto.subtle) {
      try {
        const msgBuffer = new TextEncoder().encode(message);
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        return hashHex;
      } catch (err) {
        console.warn('SubtleCrypto error, falling back to JS implementation:', err);
      }
    }
    return sha256Fallback(message);
  }

  // Initialize the admin module
  function init() {
    // DOM elements for Auth
    loginCard = document.getElementById('admin-login-card');
    loginForm = document.getElementById('login-form');
    loginPassword = document.getElementById('admin-password');
    loginError = document.getElementById('login-error');
    dashboardContainer = document.getElementById('admin-dashboard-container');
    btnAdminLogout = document.getElementById('btn-admin-logout');

    // DOM for tabs & filters
    tabTriggers = document.querySelectorAll('.tab-trigger');
    tabContents = document.querySelectorAll('.tab-content');
    inputRepo = document.getElementById('github-repo');
    inputBranch = document.getElementById('github-branch');
    repoLabel = document.getElementById('repo-label');
    btnSaveRepo = document.getElementById('btn-save-repo');

    deployStatusLabel = document.getElementById('deploy-status-label');
    deployStatusDesc = document.getElementById('deploy-status-desc');
    deployProgressFill = document.getElementById('deploy-progress-fill');

    // Load from template attributes
    const container = document.querySelector('.admin-container');
    if (container) {
      vocab = JSON.parse(container.getAttribute('data-vocab') || '[]');
      quizzes = JSON.parse(container.getAttribute('data-quizzes') || '[]');
      listening = JSON.parse(container.getAttribute('data-listening') || '[]');
      lessons = JSON.parse(container.getAttribute('data-lessons') || '[]');
    }

    checkAuthentication();

    // Load config preferences
    const savedRepo = localStorage.getItem('cms_git_repo');
    const savedBranch = localStorage.getItem('cms_git_branch');
    if (savedRepo) {
      gitRepo = savedRepo;
      if (inputRepo) inputRepo.value = savedRepo;
    }
    if (savedBranch) {
      gitBranch = savedBranch;
      if (inputBranch) inputBranch.value = savedBranch;
    }

    if (repoLabel) {
      repoLabel.innerText = `${gitRepo}:${gitBranch}`;
    }

    renderCurrentTab();
    setupEventHandlers();
  }

  // --- Auth Helper logic ---
  async function checkAuthentication() {
    const isAuthed = sessionStorage.getItem('cms_admin_auth') === 'true';
    if (isAuthed) {
      loginCard?.classList.add('hidden');
      dashboardContainer?.classList.remove('hidden');
      startDeploymentTracking();
    } else {
      loginCard?.classList.remove('hidden');
      dashboardContainer?.classList.add('hidden');
    }
  }

  function setupEventHandlers() {
    // Handle login submission
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = loginPassword ? loginPassword.value : '';
      const hashed = await sha256(password);

      if (hashed === TARGET_HASH) {
        sessionStorage.setItem('cms_admin_auth', 'true');
        loginError?.classList.add('hidden');
        if (loginPassword) loginPassword.value = '';
        checkAuthentication();
      } else {
        loginError?.classList.remove('hidden');
        if (loginPassword) loginPassword.value = '';
      }
    });

    // Handle logout
    btnAdminLogout?.addEventListener('click', () => {
      sessionStorage.removeItem('cms_admin_auth');
      checkAuthentication();
    });

    tabTriggers?.forEach(btn => {
      btn.addEventListener('click', () => {
        tabTriggers.forEach(t => t.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));
        
        btn.classList.add('active');
        activeTab = btn.getAttribute('data-tab') || 'words';
        const panel = document.getElementById(`tab-panel-${activeTab}`);
        if (panel) panel.classList.add('active');
        
        renderCurrentTab();
      });
    });

    // Filtering inputs
    ['search-words', 'filter-words-grade'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', renderCurrentTab);
      document.getElementById(id)?.addEventListener('change', renderCurrentTab);
    });
    ['search-quizzes', 'filter-quizzes-grade', 'filter-quizzes-type'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', renderCurrentTab);
      document.getElementById(id)?.addEventListener('change', renderCurrentTab);
    });
    ['search-listening', 'filter-listening-grade'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', renderCurrentTab);
      document.getElementById(id)?.addEventListener('change', renderCurrentTab);
    });
    ['search-lessons', 'filter-lessons-grade'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', renderCurrentTab);
      document.getElementById(id)?.addEventListener('change', renderCurrentTab);
    });

    btnSaveRepo?.addEventListener('click', () => {
      if (inputRepo && inputBranch) {
        gitRepo = inputRepo.value.trim();
        gitBranch = inputBranch.value.trim();
        localStorage.setItem('cms_git_repo', gitRepo);
        localStorage.setItem('cms_git_branch', gitBranch);
        if (repoLabel) {
          repoLabel.innerText = `${gitRepo}:${gitBranch}`;
        }
        startDeploymentTracking();
      }
    });
  }

  // Safe run on page ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function renderCurrentTab() {
    if (activeTab === 'words') renderWordsTable();
    else if (activeTab === 'quizzes') renderQuizzesTable();
    else if (activeTab === 'listening') renderListeningTable();
    else if (activeTab === 'lessons') renderLessonsTable();
  }

  // --- Render Words ---
  function renderWordsTable() {
    const tbody = document.getElementById('table-body-words');
    if (!tbody) return;

    const query = document.getElementById('search-words')?.value.toLowerCase() || '';
    const gradeFilter = document.getElementById('filter-words-grade')?.value || 'all';

    const filtered = vocab.filter(item => {
      const matchQuery = item.word.toLowerCase().includes(query) || 
                         (item.definition || '').toLowerCase().includes(query);
      const matchGrade = gradeFilter === 'all' || item.grade.toString() === gradeFilter;
      return matchQuery && matchGrade;
    });

    tbody.innerHTML = filtered.length === 0 
      ? `<tr><td colspan="7" class="text-center">No words found.</td></tr>`
      : filtered.map(item => `
          <tr>
            <td><span class="badge badge-grade">G${item.grade}</span></td>
            <td><strong>${item.word}</strong></td>
            <td>${item.type}</td>
            <td><code>${item.ipa || ''}</code></td>
            <td>${item.emoji}</td>
            <td class="bilingual-cell"><div class="cell-en">${item.definition}</div><div class="cell-kh">${item.definitionKh}</div></td>
            <td class="bilingual-cell"><div class="cell-en">${item.example}</div><div class="cell-kh">${item.exampleKh}</div></td>
          </tr>
        `).join('');
  }

  // --- Render Quizzes ---
  function renderQuizzesTable() {
    const tbody = document.getElementById('table-body-quizzes');
    if (!tbody) return;

    const query = document.getElementById('search-quizzes')?.value.toLowerCase() || '';
    const gradeFilter = document.getElementById('filter-quizzes-grade')?.value || 'all';
    const typeFilter = document.getElementById('filter-quizzes-type')?.value || 'all';

    const filtered = quizzes.filter(item => {
      const matchQuery = item.questionText.toLowerCase().includes(query);
      const matchGrade = gradeFilter === 'all' || item.grade.toString() === gradeFilter;
      const matchType = typeFilter === 'all' || item.type === typeFilter;
      return matchQuery && matchGrade && matchType;
    });

    tbody.innerHTML = filtered.length === 0
      ? `<tr><td colspan="6" class="text-center">No questions found.</td></tr>`
      : filtered.map(item => `
          <tr>
            <td><span class="badge badge-grade">G${item.grade}</span></td>
            <td>${item.type}</td>
            <td class="bilingual-cell"><div class="cell-en">${item.questionText}</div><div class="cell-kh">${item.questionTextKh}</div></td>
            <td>
              <ol class="options-list">
                ${item.options.map((opt, oIdx) => `<li class="${oIdx === item.correctAnswer ? 'correct' : ''}">${opt}</li>`).join('')}
              </ol>
            </td>
            <td><strong>${item.options[item.correctAnswer] || ''}</strong></td>
            <td class="bilingual-cell"><div class="cell-en">${item.explanation}</div><div class="cell-kh">${item.explanationKh}</div></td>
          </tr>
        `).join('');
  }

  // --- Render Listening ---
  function renderListeningTable() {
    const tbody = document.getElementById('table-body-listening');
    if (!tbody) return;

    const query = document.getElementById('search-listening')?.value.toLowerCase() || '';
    const gradeFilter = document.getElementById('filter-listening-grade')?.value || 'all';

    const filtered = listening.filter(item => {
      const matchQuery = item.title.toLowerCase().includes(query) || item.text.toLowerCase().includes(query);
      const matchGrade = gradeFilter === 'all' || item.difficulty === gradeFilter;
      return matchQuery && matchGrade;
    });

    tbody.innerHTML = filtered.length === 0
      ? `<tr><td colspan="4" class="text-center">No exercises found.</td></tr>`
      : filtered.map(item => `
          <tr>
            <td><span class="badge badge-grade">${item.difficulty}</span></td>
            <td class="bilingual-cell"><div class="cell-en">${item.title}</div><div class="cell-kh">${item.titleKh}</div></td>
            <td><strong>"${item.text}"</strong></td>
            <td class="bilingual-cell"><div class="cell-en">${item.clue}</div><div class="cell-kh">${item.clueKh}</div></td>
          </tr>
        `).join('');
  }

  // --- Render Lessons ---
  function renderLessonsTable() {
    const tbody = document.getElementById('table-body-lessons');
    if (!tbody) return;

    const query = document.getElementById('search-lessons')?.value.toLowerCase() || '';
    const gradeFilter = document.getElementById('filter-lessons-grade')?.value || 'all';

    const filtered = lessons.filter(item => {
      const matchQuery = item.title.toLowerCase().includes(query) || (item.id || '').toLowerCase().includes(query);
      const matchGrade = gradeFilter === 'all' || item.grade.toString() === gradeFilter;
      return matchQuery && matchGrade;
    });

    tbody.innerHTML = filtered.length === 0
      ? `<tr><td colspan="4" class="text-center">No lessons found.</td></tr>`
      : filtered.map(item => `
          <tr>
            <td><span class="badge badge-grade">G${item.grade}</span></td>
            <td><code>${item.id}</code></td>
            <td class="bilingual-cell"><div class="cell-en">${item.title}</div><div class="cell-kh">${item.titleKh}</div></td>
            <td><code>${item.pdfUrl || 'No PDF'}</code></td>
          </tr>
        `).join('');
  }

  // --- GitHub Pages Deployment Polling ---
  let trackingInterval = null;
  function startDeploymentTracking() {
    if (trackingInterval) clearInterval(trackingInterval);
    
    deployStatusLabel.className = 'status-indicator checking';
    deployStatusLabel.innerText = 'Queueing...';
    deployStatusDesc.innerText = 'Checking GitHub Actions workflow runs...';
    deployProgressFill.style.width = '15%';

    let attempts = 0;
    const fetchStatus = async () => {
      try {
        const res = await fetch(`https://api.github.com/repos/${gitRepo}/actions/runs?branch=${gitBranch}&per_page=3`);

        if (res.ok) {
          const runData = await res.json();
          const latestRun = runData.workflow_runs?.[0];
          
          if (latestRun) {
            const status = latestRun.status;
            const conclusion = latestRun.conclusion;
            
            if (status === 'queued') {
              deployStatusLabel.className = 'status-indicator checking';
              deployStatusLabel.innerText = 'Queued ⏳';
              deployStatusDesc.innerText = `GitHub Pages deployment run #${latestRun.run_number} is in queue...`;
              deployProgressFill.style.width = '30%';
            } else if (status === 'in_progress') {
              deployStatusLabel.className = 'status-indicator in-progress';
              deployStatusLabel.innerText = 'Building 🛠️';
              deployStatusDesc.innerText = `Astro static pages compilation (run #${latestRun.run_number}) is in progress...`;
              deployProgressFill.style.width = '60%';
            } else if (status === 'completed') {
              if (conclusion === 'success') {
                deployStatusLabel.className = 'status-indicator success';
                deployStatusLabel.innerText = 'Live! ✅';
                deployStatusDesc.innerText = `Successfully deployed static build to production (Build #${latestRun.run_number}).`;
                deployProgressFill.style.width = '100%';
              } else {
                deployStatusLabel.className = 'status-indicator failure';
                deployStatusLabel.innerText = 'Failed ❌';
                deployStatusDesc.innerText = `Deployment runner completed with error conclusion: ${conclusion}`;
                deployProgressFill.style.width = '100%';
              }
            }
          } else {
            deployStatusLabel.className = 'status-indicator failure';
            deployStatusLabel.innerText = 'Not Found';
            deployStatusDesc.innerText = 'No recent Actions workflow runs found on branch.';
            deployProgressFill.style.width = '0%';
          }
        } else {
          throw new Error('API fetch failed');
        }
      } catch (err) {
        deployStatusLabel.className = 'status-indicator offline';
        deployStatusLabel.innerText = 'API Rate Limit / Error';
        deployStatusDesc.innerText = 'Unable to fetch status. Check your internet connection or verify the repository name.';
      }
    };

    fetchStatus();
    trackingInterval = setInterval(fetchStatus, 15000);
  }
</script>

