---
interface Props {
  word: string;
  ipa: string;
  type: string;
  definition: string;
  definitionKh: string;
  example: string;
  exampleKh: string;
  emoji?: string;
  imageUrl?: string;
}

const { word, ipa, type, definition, definitionKh, example, exampleKh, emoji, imageUrl } = Astro.props;

// Robustly resolve image paths relative to the base URL
const cleanBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const cleanImage = imageUrl ? (imageUrl.startsWith('/') ? imageUrl.slice(1) : imageUrl) : '';
const resolvedImageUrl = imageUrl ? `${cleanBase}${cleanImage}` : '';

// Determine pastel category color
const typeColors: Record<string, string> = {
  noun: 'rgba(56, 189, 248, 0.15)', // light blue
  verb: 'rgba(251, 146, 60, 0.15)', // light orange
  adjective: 'rgba(52, 211, 153, 0.15)', // light green
};

const typeBorders: Record<string, string> = {
  noun: '#38bdf8',
  verb: '#fb923c',
  adjective: '#34d399',
};

const typeTranslations: Record<string, string> = {
  noun: 'នាមសព្ទ (Noun)',
  verb: 'កិរិយាសព្ទ (Verb)',
  adjective: 'គុណនាម (Adj)',
};

const badgeColor = typeColors[type.toLowerCase()] || 'rgba(167, 139, 250, 0.15)';
const borderColor = typeBorders[type.toLowerCase()] || '#a78bfa';
const typeKhmer = typeTranslations[type.toLowerCase()] || type;
---

<div class="flashcard-container">
  <div class="flashcard-inner">
    
    <!-- Front of the Card -->
    <div class="card-side card-front" style={`--type-border-color: ${borderColor};`}>
      <div class="card-header">
        <span class="word-type" style={`background-color: ${badgeColor}; color: #1a202c;`}>
          <span class="en-text">{type}</span>
          <span class="kh-text">{typeKhmer}</span>
        </span>
        <div class="card-actions">
          <button class="speak-btn" data-word={word} data-emoji={emoji} data-type={type} aria-label="Listen to pronunciation">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="speaker-icon">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
          </button>
          <button class="learn-btn" data-word={word} aria-label="Mark as learned">
            <span class="learn-check">✓</span>
          </button>
        </div>
      </div>
      <div class="card-body">
        <div class="visual-container">
          {imageUrl ? (
            <img src={resolvedImageUrl} alt={word} class="vocab-sticker" />
          ) : (
            <span class="vocab-emoji">{emoji}</span>
          )}
        </div>
        <h2 class="word-title">{word}</h2>
        <p class="word-ipa">{ipa}</p>
      </div>
      <div class="card-footer">
        <span class="tap-hint en-text">👉 Tap Card to Flip! 👈</span>
        <span class="tap-hint kh-text">👉 ចុចលើកាតដើម្បីផ្ងារ! 👈</span>
      </div>
    </div>
    
    <div class="card-side card-back" style={`--type-border-color: ${borderColor};`}>
      <div class="card-header">
        <span class="word-type" style={`background-color: ${badgeColor}; color: #1a202c;`}>
          <span class="en-text">{type}</span>
          <span class="kh-text">{typeKhmer}</span>
        </span>
        <button class="learn-btn" data-word={word} aria-label="Mark as learned">
          <span class="learn-check">✓</span>
        </button>
      </div>
      <div class="card-body">
        <p class="definition-label">
          <span class="en-text">What it means:</span>
          <span class="kh-text">ន័យពាក្យ៖</span>
        </p>
        <p class="word-definition">{definition}</p>
        <p class="word-definition-kh kh-text-block">{definitionKh}</p>
        
        <div class="divider"></div>
        
        <p class="example-label">
          <span class="en-text">Practice Sentence:</span>
          <span class="kh-text">ល្បះឧទាហរណ៍៖</span>
        </p>
        <p class="word-example">"{example}"</p>
        <p class="word-example-kh kh-text-block">"{exampleKh}"</p>
      </div>
      <div class="card-footer">
        <span class="tap-hint en-text">👉 Tap Card to Flip Back! 👈</span>
        <span class="tap-hint kh-text">👉 ចុចលើកាតដើម្បីផ្កាប់វិញ! 👈</span>
      </div>
    </div>
    
  </div>
</div>

<script>
  // Add flipping logic
  const cards = document.querySelectorAll('.flashcard-container');
  cards.forEach(card => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.speak-btn') || target.closest('.learn-btn')) {
        return;
      }
      
      card.classList.add('flipping');
      card.classList.toggle('flipped');
      
      // Remove flipping class after transition completes
      setTimeout(() => {
        card.classList.remove('flipping');
      }, 600);
    });
  });

  // Helper to map words/emojis to specific cartoon animations
  function getAnimationClass(word: string, emoji: string, type: string): string {
    const w = word.toLowerCase();
    
    // Marine/Swimming (Fish, sharks, coral polyps, waves)
    if (
      ['fish', 'shark', 'sea', 'coral'].includes(w) ||
      ['🐟', '🦈', '🐠', '🌊'].includes(emoji)
    ) {
      return 'anim-swim-active';
    }
    
    // Hop/Jump (Animals)
    if (
      ['dog', 'cat', 'elephant', 'rabbit', 'bear', 'frog'].includes(w) ||
      ['🐶', '🐘', '🐱', '🐸', '🐰', '🐻'].includes(emoji)
    ) {
      return 'anim-jump-active';
    }
    
    // Spooky floating ghost
    if (
      w === 'scary' ||
      emoji === '👻'
    ) {
      return 'anim-ghost-active';
    }
    
    // Jingling mechanical objects
    if (
      w === 'key' ||
      ['🔑', '🔔', '🚪', '🪙'].includes(emoji)
    ) {
      return 'anim-jingle-active';
    }
    
    // Horizontal eye scanning
    if (
      ['see', 'look', 'watch', 'eye'].includes(w) ||
      ['👀', '👁️'].includes(emoji)
    ) {
      return 'anim-scan-active';
    }
    
    // Color pulsating glows
    if (
      ['red', 'yellow', 'blue', 'green', 'orange', 'purple'].includes(w) ||
      ['❤️', '💛', '💙', '💚', '🧡', '💜'].includes(emoji)
    ) {
      return 'anim-glow-active';
    }
    
    // Default playful pop
    return 'anim-pop-active';
  }

  // Add SpeechSynthesis logic
  const speakButtons = document.querySelectorAll('.speak-btn');
  speakButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const word = btn.getAttribute('data-word');
      const emoji = btn.getAttribute('data-emoji') || '';
      const type = btn.getAttribute('data-type') || '';
      
      if (word && 'speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        
        const utterance = new SpeechSynthesisUtterance(word.toLowerCase());
        utterance.lang = 'en-US';
        utterance.rate = 0.6;
        window.speechSynthesis.speak(utterance);
        
        btn.classList.add('speaking');
        const container = btn.closest('.flashcard-container') as any;
        const animClass = getAnimationClass(word, emoji, type);
        
        if (container) {
          // Clear any active animation timeout to prevent sudden truncation
          if (container._animTimeout) {
            clearTimeout(container._animTimeout);
            container.classList.remove(container._lastAnimClass || animClass);
          }
          
          container.classList.add(animClass);
          container._lastAnimClass = animClass;
          
          // Keep the class active for a fixed 1.5s matching CSS duration limits
          container._animTimeout = setTimeout(() => {
            container.classList.remove(animClass);
            container._animTimeout = null;
            container._lastAnimClass = null;
          }, 1500);
        }
        
        utterance.onend = () => {
          btn.classList.remove('speaking');
        };
      } else {
        alert("Text-to-speech is not supported in this browser.");
      }
    });
  });
</script>

<style>
  .flashcard-container {
    perspective: 1000px;
    width: 100%;
    height: 340px;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .flashcard-container:hover {
    transform: scale(1.04) translateY(-4px);
  }

  .flashcard-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.34, 1, 0.64, 1);
    transform-style: preserve-3d;
  }

  /* Use a smooth snapping curve without overshooting backface angle (prevents flicker) */
  .flashcard-container.flipping .flashcard-inner {
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .flashcard-container.flipped .flashcard-inner {
    transform: rotateY(180deg);
  }

  .card-side {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: var(--bg-surface);
    border: 3.5px solid #000000;
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 6px 6px 0px var(--type-border-color, #000000);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease, background-color 0.3s ease;
    transform-style: preserve-3d;
  }

  .flashcard-container:hover .card-side {
    box-shadow: 9px 9px 0px var(--type-border-color, #000000);
  }

  .card-front {
    z-index: 2;
    transform: rotateY(0deg);
  }

  .card-back {
    transform: rotateY(180deg);
    background: #fdfdfd;
  }

  /* Card Header styling */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .word-type {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 12px;
    border-radius: 20px;
    border: 2px solid #000000;
  }

  .speak-btn {
    background: #ffffff;
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #1a202c;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .speak-btn:hover {
    background: #fef08a;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .speak-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px #000000;
  }

  .speak-btn.speaking {
    background: #bae6fd;
    animation: speakerPulse 1s infinite alternate;
  }

  .speaker-icon {
    width: 20px;
    height: 20px;
  }

  /* Card Body styling */
  .card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    gap: 6px;
    text-align: center;
  }

  .word-title {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    color: #1a202c;
  }

  .word-ipa {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: 500;
  }

  /* Back Card Details */
  .card-back .card-body {
    text-align: left;
    justify-content: flex-start;
    gap: 4px;
    padding-top: 10px;
    overflow-y: auto;
    padding-right: 6px;
  }

  .card-back .card-body::-webkit-scrollbar {
    width: 6px;
  }

  .card-back .card-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .card-back .card-body::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }

  .card-back .card-body::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  .definition-label, .example-label {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-primary);
    letter-spacing: 0.5px;
  }

  .word-definition {
    font-size: 1.05rem;
    color: #2d3748;
    font-weight: 600;
    line-height: 1.4;
  }

  .word-definition-kh {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    font-weight: 500;
    margin-top: 4px;
    line-height: 1.4;
  }

  .divider {
    height: 3px;
    background: #f1f5f9;
    margin: 12px 0;
    border-radius: 2px;
  }

  .word-example {
    font-size: 1rem;
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: 500;
    line-height: 1.4;
  }

  .word-example-kh {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-weight: 500;
    margin-top: 4px;
    line-height: 1.4;
  }

  /* Card Footer styling */
  .card-footer {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .tap-hint {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 700;
    transition: var(--transition-smooth);
  }

  .flashcard-container:hover .tap-hint {
    color: var(--color-primary);
  }

  /* Visual Container styling */
  .visual-container {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 110px;
    margin-bottom: 8px;
    transition: var(--transition-smooth);
  }

  .vocab-sticker {
    max-width: 100px;
    max-height: 100px;
    object-fit: contain;
    filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.08));
    animation: float 4s ease-in-out infinite alternate;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .vocab-emoji {
    font-size: 4.2rem;
    line-height: 1;
    filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.08));
    animation: float 4s ease-in-out infinite alternate;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: inline-block;
  }

  /* Hover bounce animation */
  .flashcard-container:hover .vocab-sticker,
  .flashcard-container:hover .vocab-emoji {
    transform: scale(1.12) rotate(3deg);
  }

  /* Active custom animations triggered by speaking */
  .flashcard-container.anim-swim-active .vocab-sticker,
  .flashcard-container.anim-swim-active .vocab-emoji {
    animation: animSwim 1.5s ease-in-out;
  }

  .flashcard-container.anim-jump-active .vocab-sticker,
  .flashcard-container.anim-jump-active .vocab-emoji {
    animation: animJump 1.5s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .flashcard-container.anim-ghost-active .vocab-sticker,
  .flashcard-container.anim-ghost-active .vocab-emoji {
    animation: animGhost 1.5s ease-in-out;
  }

  .flashcard-container.anim-jingle-active .vocab-sticker,
  .flashcard-container.anim-jingle-active .vocab-emoji {
    animation: animJingle 1.2s ease-in-out;
  }

  .flashcard-container.anim-scan-active .vocab-sticker,
  .flashcard-container.anim-scan-active .vocab-emoji {
    animation: animScan 1.5s ease-in-out;
  }

  .flashcard-container.anim-glow-active .vocab-sticker,
  .flashcard-container.anim-glow-active .vocab-emoji {
    animation: animGlow 1.5s ease-in-out;
  }

  .flashcard-container.anim-pop-active .vocab-sticker,
  .flashcard-container.anim-pop-active .vocab-emoji {
    animation: animPop 1.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes float {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    100% {
      transform: translateY(-8px) rotate(-2deg);
    }
  }

  @keyframes animSwim {
    0% { transform: translateX(0) scaleX(1); }
    20% { transform: translateX(-45px) scaleX(1) rotate(-5deg); }
    45% { transform: translateX(-45px) scaleX(-1); }
    50% { transform: translateX(-45px) scaleX(-1); }
    75% { transform: translateX(45px) scaleX(-1) rotate(5deg); }
    95% { transform: translateX(45px) scaleX(1); }
    100% { transform: translateX(0) scaleX(1); }
  }

  @keyframes animJump {
    0% { transform: translateY(0) scale(1, 1); }
    15% { transform: translateY(0) scale(1.2, 0.75); }
    35% { transform: translateY(-30px) scale(0.85, 1.2); }
    60% { transform: translateY(5px) scale(1.05, 0.95); }
    80% { transform: translateY(-5px) scale(0.98, 1.02); }
    100% { transform: translateY(0) scale(1, 1); }
  }

  @keyframes animGhost {
    0% { transform: translateY(0) scale(1); opacity: 1; filter: blur(0); }
    25% { transform: translateY(-20px) scale(1.1) rotate(5deg); opacity: 0.5; filter: blur(1.5px); }
    50% { transform: translateY(-10px) scale(0.95) rotate(-5deg); opacity: 0.75; }
    75% { transform: translateY(-20px) scale(1.05) rotate(3deg); opacity: 0.5; filter: blur(1.5px); }
    100% { transform: translateY(0) scale(1); opacity: 1; filter: blur(0); }
  }

  @keyframes animJingle {
    0%, 100% { transform: rotate(0) scale(1); }
    15%, 45%, 75% { transform: rotate(-15deg) scale(1.05); }
    30%, 60%, 90% { transform: rotate(15deg) scale(1.05); }
  }

  @keyframes animScan {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-15px) scale(1.05); }
    60% { transform: translateX(15px) scale(1.05); }
  }

  @keyframes animGlow {
    0%, 100% { transform: scale(1); filter: drop-shadow(0 0 0px rgba(167, 139, 250, 0)); }
    50% { transform: scale(1.2); filter: drop-shadow(0 0 20px var(--color-primary)); }
  }

  @keyframes animPop {
    0% { transform: scale(1); }
    30% { transform: scale(1.25) rotate(-6deg); }
    60% { transform: scale(0.85) rotate(6deg); }
    80% { transform: scale(1.05) rotate(-2deg); }
    100% { transform: scale(1) rotate(0); }
  }

  @keyframes speakerPulse {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.15);
    }
  }

  /* Progress learn checkmark styling */
  .card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .learn-btn {
    background: #ffffff;
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
    font-size: 1.3rem;
    font-weight: bold;
  }

  .learn-btn:hover {
    background: #e2e8f0;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .learn-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px #000000;
  }

  .learn-btn.learned {
    background: var(--color-success);
    color: #ffffff;
    border-color: #000000;
    box-shadow: 3px 3px 0px #000000;
    animation: bounceCheck 0.4s ease-out;
  }

  .learn-btn.learned:hover {
    box-shadow: 5px 5px 0px #000000;
    transform: translate(-2px, -2px);
  }

  .learn-btn.learned:active {
    box-shadow: 1px 1px 0px #000000;
    transform: translate(2px, 2px);
  }

  @keyframes bounceCheck {
    0% { transform: scale(0.6); }
    70% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }
</style>
