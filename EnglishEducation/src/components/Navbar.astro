---
const pathname = new URL(Astro.request.url).pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = pathname.replace(/\/$/, "").replace(new RegExp(`^${base}`), "");
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="navbar-header">
  <div class="navbar-container">
    <a href={baseUrl} class="logo">
      🎈 <span class="logo-accent">Kids</span>Edu
    </a>
    
    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-toggle" aria-label="Toggle Menu" id="menuToggle">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
    
    <div class="nav-wrapper" id="navMenu">
      <nav class="nav-menu">
        <a href={baseUrl} class={currentPath === "" ? "active nav-link" : "nav-link"}>
          <span class="en-text">🏠 Home</span>
          <span class="kh-text">🏠 ទំព័រដើម</span>
        </a>
        <a href={`${baseUrl}vocabulary`} class={currentPath === "/vocabulary" ? "active nav-link" : "nav-link"}>
          <span class="en-text">📇 Words</span>
          <span class="kh-text">📇 ពាក្យសិក្សា</span>
        </a>
        <a href={`${baseUrl}quiz`} class={currentPath === "/quiz" ? "active nav-link" : "nav-link"}>
          <span class="en-text">✏️ Quiz</span>
          <span class="kh-text">✏️ តេស្តសាកល្បង</span>
        </a>
        <a href={`${baseUrl}listening`} class={currentPath === "/listening" ? "active nav-link" : "nav-link"}>
          <span class="en-text">🎧 Listen</span>
          <span class="kh-text">🎧 ស្តាប់កម្សាន្ត</span>
        </a>
        <a href={`${baseUrl}lessons`} class={currentPath === "/lessons" ? "active nav-link" : "nav-link"}>
          <span class="en-text">📖 Lessons</span>
          <span class="kh-text">📖 មេរៀន</span>
        </a>
        <a href={`${baseUrl}contact`} class={currentPath === "/contact" ? "active nav-link" : "nav-link"}>
          <span class="en-text">✉️ Contact</span>
          <span class="kh-text">✉️ ទំនាក់ទំនង</span>
        </a>
        <a href={`${baseUrl}admin`} class={currentPath === "/admin" ? "active nav-link" : "nav-link"}>
          <span class="en-text">🔑 Admin</span>
          <span class="kh-text">🔑 គ្រប់គ្រង</span>
        </a>
      </nav>

      <!-- Profile Status Card -->
      <div id="navbar-profile-container" class="navbar-profile-container"></div>

      <!-- Language Toggle Button -->
      <button class="lang-toggle-btn" id="langToggle" aria-label="Switch language">
        <span class="en-text">🇰🇭 ខ្មែរ</span>
        <span class="kh-text">🇬🇧 English</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { profileManager } from '../scripts/profileManager';

  const menuToggle = document.getElementById('menuToggle');
  const navMenu = document.getElementById('navMenu');
  const langToggle = document.getElementById('langToggle');

  // Mobile menu drawer
  if (menuToggle && navMenu) {
    menuToggle.addEventListener('click', () => {
      menuToggle.classList.toggle('open');
      navMenu.classList.toggle('active');
    });
  }

  // Language toggle logic
  if (langToggle) {
    langToggle.addEventListener('click', () => {
      const isKhmer = document.documentElement.classList.toggle('lang-khmer');
      localStorage.setItem('preferredLang', isKhmer ? 'khmer' : 'english');
    });
  }

  // Dynamic Profile Navbar status
  function updateNavbarProfile() {
    const container = document.getElementById('navbar-profile-container');
    if (!container) return;

    const profile = profileManager.getProfile();
    const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

    if (profile) {
      const stars = profileManager.calculateStars(profile);
      container.innerHTML = `
        <div class="nav-profile-wrapper">
          <a href="${baseUrl}profile" class="nav-profile-chip" title="View Profile">
            <span class="chip-avatar">${profile.avatar}</span>
            <span class="chip-info">
              <span class="chip-name">${profile.nickname}</span>
              <span class="chip-stars">⭐ ${stars}</span>
            </span>
          </a>
          <button type="button" class="nav-switch-btn" id="navbar-switch-toggle" title="Switch Profile">
            🔄
          </button>
          <div class="nav-switch-dropdown hidden" id="navbar-switch-dropdown">
            <div class="dropdown-header">Switch User / ប្តូរគណនី</div>
            <div class="dropdown-list" id="navbar-switch-list">
              <!-- Injected profiles -->
            </div>
            <a href="${baseUrl}profile" class="dropdown-add-btn">+ Add Profile</a>
          </div>
        </div>
      `;
    } else {
      container.innerHTML = `
        <a href="${baseUrl}profile" class="nav-profile-btn">
          <span class="en-text">Join Academy 🚀</span>
          <span class="kh-text">ចុះឈ្មោះរៀន 🚀</span>
        </a>
      `;
    }
  }

  // Handle switch click toggle
  document.addEventListener('click', (e: any) => {
    const toggle = document.getElementById('navbar-switch-toggle');
    const dropdown = document.getElementById('navbar-switch-dropdown');
    
    if (toggle && dropdown) {
      if (toggle.contains(e.target)) {
        dropdown.classList.toggle('hidden');
        renderNavbarDropdownList();
      } else if (!dropdown.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    }
  });

  function renderNavbarDropdownList() {
    const listEl = document.getElementById('navbar-switch-list');
    if (!listEl) return;
    listEl.innerHTML = '';

    const profiles = profileManager.getProfilesList();
    const activeProfile = profileManager.getProfile();

    const otherProfiles = profiles.filter(p => p.id !== activeProfile?.id);
    if (otherProfiles.length === 0) {
      listEl.innerHTML = `<div class="dropdown-empty">No other profiles / គ្មានគណនីផ្សេង</div>`;
      return;
    }

    otherProfiles.forEach(p => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'dropdown-item';
      item.innerHTML = `
        <span class="item-avatar">${p.avatar}</span>
        <span class="item-name">${p.nickname}</span>
      `;
      item.addEventListener('click', () => {
        profileManager.setActiveProfile(p.id);
        location.reload();
      });
      listEl.appendChild(item);
    });
  }

  document.addEventListener('DOMContentLoaded', updateNavbarProfile);
  window.addEventListener('profileChanged', updateNavbarProfile);
  // Initial check
  updateNavbarProfile();
</script>

<style>
  .navbar-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 75px;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 3px solid #e2e8f0;
  }

  .navbar-container {
    max-width: 1100px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 900;
    color: #1a202c;
    text-decoration: none;
    letter-spacing: -0.5px;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .logo-accent {
    color: var(--color-primary);
  }

  .logo:hover {
    transform: scale(1.05);
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    transition: var(--transition-smooth);
    border: 2px solid transparent;
  }

  .nav-link:hover {
    color: #1a202c;
    background: rgba(159, 122, 234, 0.05);
    transform: translateY(-1px);
  }

  .nav-link.active {
    color: var(--color-primary);
    background: #f3e8ff;
    border-color: rgba(159, 122, 234, 0.2);
  }

  /* Playful Language Switcher Button */
  .lang-toggle-btn {
    background: #ffffff;
    border: 2.5px solid #000000;
    box-shadow: 0 3px 0 #000000;
    padding: 6px 14px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition-smooth);
    display: inline-flex;
    align-items: center;
    color: #1a202c;
  }

  .lang-toggle-btn:hover {
    background: #bae6fd; /* Soft Blue highlight */
    transform: translateY(-2px);
    box-shadow: 0 5px 0 #000000;
  }

  .lang-toggle-btn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #000000;
  }

  /* Profile Status styles */
  .navbar-profile-container {
    display: flex;
    align-items: center;
  }

  .nav-profile-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 2.5px solid #000000;
    box-shadow: 0 3px 0 #000000;
    padding: 4px 10px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: #1a202c;
    transition: var(--transition-smooth);
  }

  .nav-profile-chip:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 #000000;
    background: #fdfcfa;
  }

  .nav-profile-chip:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #000000;
  }

  .chip-avatar {
    font-size: 1.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chip-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.1;
  }

  .chip-name {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 900;
    max-width: 80px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chip-stars {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--color-warning);
    -webkit-text-stroke: 0.5px #000000;
  }

  .nav-profile-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: #ffffff;
    border: 2.5px solid #000000;
    box-shadow: 0 3px 0 #000000;
    padding: 6px 14px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition-smooth);
    text-decoration: none;
  }

  .nav-profile-btn:hover {
    background: #8b5cf6;
    transform: translateY(-2px);
    box-shadow: 0 5px 0 #000000;
    color: #ffffff;
  }

  .nav-profile-btn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #000000;
  }

  /* Mobile menu toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 1001;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 3px;
    background-color: #1a202c;
    border-radius: 2px;
    transition: var(--transition-smooth);
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    .nav-wrapper {
      position: fixed;
      top: 75px;
      left: 0;
      width: 100%;
      height: calc(100vh - 75px);
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(15px);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 24px;
      padding: 40px;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      border-top: 3px solid #e2e8f0;
    }

    .nav-wrapper.active {
      transform: translateX(0);
    }

    .nav-menu {
      flex-direction: column;
      width: 100%;
      gap: 12px;
    }

    .nav-link {
      font-size: 1.25rem;
      width: 100%;
      text-align: center;
      padding: 12px;
    }

    .lang-toggle-btn {
      font-size: 1.1rem;
      padding: 10px 24px;
      width: 80%;
      justify-content: center;
    }

    .mobile-toggle.open .bar:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .mobile-toggle.open .bar:nth-child(2) {
      opacity: 0;
    }

    .mobile-toggle.open .bar:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }

  /* Switch profile dropdown styles */
  .nav-profile-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-switch-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    padding: 6px;
    border-radius: 50%;
    transition: background 0.2s;
  }

  .nav-switch-btn:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .nav-switch-dropdown {
    position: absolute;
    top: 50px;
    right: 0;
    width: 220px;
    background: #ffffff;
    border: 3px solid #000000;
    border-radius: var(--radius-md);
    box-shadow: 0 6px 0 #000000;
    padding: 12px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: slideDown 0.2s ease-out;
  }

  .dropdown-header {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-text-muted);
    text-transform: uppercase;
    border-bottom: 2px dashed #e2e8f0;
    padding-bottom: 6px;
  }

  .dropdown-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    width: 100%;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s;
    font-weight: 700;
    color: #1a202c;
  }

  .dropdown-item:hover {
    background: #f7fafc;
  }

  .item-avatar {
    font-size: 1.4rem;
  }

  .dropdown-empty {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding: 8px 0;
    text-align: center;
    font-style: italic;
  }

  .dropdown-add-btn {
    text-align: center;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-primary);
    border-top: 2px dashed #e2e8f0;
    padding-top: 8px;
    text-decoration: none;
    display: block;
  }

  .dropdown-add-btn:hover {
    color: var(--color-secondary);
  }
</style>
