---
// src/components/Celebration.astro
---

<!-- Celebration Overlay Structure -->
<div id="celebration-overlay" class="celebration-overlay hidden">
  <div class="celebration-content animate-pop-in">
    <!-- Star rays background glow effect -->
    <div class="celebration-glow"></div>
    
    <!-- Lottie player container -->
    <div class="lottie-container">
      <lottie-player
        id="celebration-lottie"
        src="/EnglishEducation/animations/celebration.json"
        background="transparent"
        speed="1.2"
        style="width: 280px; height: 280px;"
        loop
        autoplay>
      </lottie-player>
    </div>

    <!-- Celebration Message Banners -->
    <div class="celebration-text-section">
      <h2 class="celebration-title animate-bounce-short">
        <span class="en-text">🎉 YOU ARE AN ENGLISH SUPERSTAR! 🎉</span>
        <span class="kh-text">🎉 អ្នកពិតជាអស្ចារ្យណាស់! 🎉</span>
      </h2>
      
      <div class="score-badge">
        <span class="en-text">Accuracy Score: <strong id="celebration-score-text">100%</strong> 🏆</span>
        <span class="kh-text">ពិន្ទុទទួលបាន: <strong id="celebration-score-text-kh">100%</strong> 🏆</span>
      </div>
      
      <p class="celebration-desc">
        <span class="en-text">Awesome work! Kiri the Kouprey is so proud of you! Keep going!</span>
        <span class="kh-text">ធ្វើបានល្អណាស់! គីរីពិតជាមានមោទនភាពចំពោះអ្នកខ្លាំងណាស់! បន្តព្យាយាមទៀតណា!</span>
      </p>
    </div>

    <!-- Close Button -->
    <button type="button" id="celebration-close-btn" class="celebration-btn">
      <span class="en-text">Awesome! 🚀</span>
      <span class="kh-text">អស្ចារ្យ! 🚀</span>
    </button>
  </div>
</div>

<!-- Load Lottie-Player Script Asynchronously via CDN -->
<script src="https://unpkg.com/@lottiefiles/lottie-player@2.0.4/dist/lottie-player.js" is:inline></script>

<script>
  import confetti from 'canvas-confetti';

  const overlay = document.getElementById('celebration-overlay');
  const closeBtn = document.getElementById('celebration-close-btn');
  const scoreTextEn = document.getElementById('celebration-score-text');
  const scoreTextKh = document.getElementById('celebration-score-text-kh');
  const lottiePlayer = document.getElementById('celebration-lottie') as any;
  
  let dismissTimeout: any = null;

  // Cheering audio sound effect (Tada success sound)
  const tadaAudio = new Audio('https://assets.mixkit.co/active_storage/sfx/2013/2013-84.wav');
  tadaAudio.volume = 0.4;

  function triggerCelebration(accuracy: number) {
    if (!overlay || !scoreTextEn || !scoreTextKh) return;

    // Reset timeouts
    if (dismissTimeout) {
      clearTimeout(dismissTimeout);
    }

    // Set score texts
    scoreTextEn.innerText = `${accuracy}%`;
    scoreTextKh.innerText = `${accuracy}%`;

    // Show overlay
    overlay.classList.remove('hidden');
    overlay.classList.add('visible');

    // Trigger confetti cascade
    fireConfettiShower();

    // Play tada sound
    tadaAudio.currentTime = 0;
    tadaAudio.play().catch(err => console.log('Audio autoplay blocked by browser policy:', err));

    // Play Lottie animation
    if (lottiePlayer && typeof lottiePlayer.play === 'function') {
      lottiePlayer.seek(0);
      lottiePlayer.play();
    }

    // Auto dismiss after 6 seconds to not block children indefinitely
    dismissTimeout = setTimeout(closeCelebration, 6500);
  }

  function closeCelebration() {
    if (!overlay) return;
    overlay.classList.remove('visible');
    
    // Add fading out transitions
    setTimeout(() => {
      overlay.classList.add('hidden');
    }, 300);

    // Pause Lottie animation
    if (lottiePlayer && typeof lottiePlayer.pause === 'function') {
      lottiePlayer.pause();
    }

    if (dismissTimeout) {
      clearTimeout(dismissTimeout);
      dismissTimeout = null;
    }
  }

  // Canvas-confetti shower launcher
  function fireConfettiShower() {
    const duration = 2.5 * 1000;
    const animationEnd = Date.now() + duration;
    const defaults = { startVelocity: 28, spread: 360, ticks: 60, zIndex: 1000000 };

    function randomInRange(min: number, max: number) {
      return Math.random() * (max - min) + min;
    }

    const interval = setInterval(function() {
      const timeLeft = animationEnd - Date.now();

      if (timeLeft <= 0) {
        return clearInterval(interval);
      }

      const particleCount = 50 * (timeLeft / duration);
      // Confetti burst from left and right edges
      confetti({ ...defaults, particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } });
      confetti({ ...defaults, particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } });
    }, 250);
  }

  // Listen to 'kiri-score-achieved' events globally
  if (typeof window !== 'undefined') {
    window.addEventListener('kiri-score-achieved', (event: any) => {
      const accuracy = event.detail?.accuracy || 0;
      // Trigger overlay only if the student did well (accuracy >= 80%)
      if (accuracy >= 80) {
        triggerCelebration(accuracy);
      }
    });

    // Close button event
    if (closeBtn) {
      closeBtn.addEventListener('click', closeCelebration);
    }
  }
</script>

<style>
  .celebration-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    background: rgba(15, 23, 42, 0.65); /* Slate 900 tint */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .celebration-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .celebration-content {
    position: relative;
    background: #ffffff;
    border: 4.5px solid #000000;
    border-radius: 28px;
    box-shadow: 12px 12px 0px #000000;
    width: 100%;
    max-width: 520px;
    padding: 35px 24px 30px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    transform: scale(0.9);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .celebration-overlay.visible .celebration-content {
    transform: scale(1);
  }

  /* Rotating sunburst/glow background behind lottie asset */
  .celebration-glow {
    position: absolute;
    top: -60px;
    left: calc(50% - 125px);
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(253, 224, 71, 0.6) 0%, rgba(253, 224, 71, 0) 70%); /* Yellow 300 glow */
    z-index: 1;
    animation: rotateGlow 8s linear infinite;
    pointer-events: none;
  }

  .lottie-container {
    position: relative;
    z-index: 2;
    margin-bottom: 10px;
    filter: drop-shadow(0px 8px 12px rgba(253, 224, 71, 0.3));
  }

  .celebration-text-section {
    position: relative;
    z-index: 2;
    margin-bottom: 24px;
  }

  .celebration-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 900;
    color: #8b5cf6; /* Violet 500 */
    text-shadow: 1.5px 1.5px 0px #000000;
    -webkit-text-stroke: 1.5px #000000;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  .score-badge {
    display: inline-block;
    background: #fef08a; /* Yellow 200 */
    border: 3px solid #000000;
    border-radius: 16px;
    padding: 8px 20px;
    font-weight: 900;
    font-size: 1.15rem;
    box-shadow: 4px 4px 0px #000000;
    margin-bottom: 16px;
    transform: rotate(-2deg);
  }

  .score-badge strong {
    color: #e11d48; /* Rose 600 */
    font-size: 1.25rem;
  }

  .celebration-desc {
    font-size: 0.95rem;
    color: #4b5563;
    font-weight: 700;
    line-height: 1.5;
    max-width: 420px;
    margin: 0 auto;
  }

  /* Celebrating Close Button */
  .celebration-btn {
    position: relative;
    z-index: 2;
    background: #10b981; /* Emerald 500 */
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 900;
    padding: 12px 40px;
    border: 3.5px solid #000000;
    border-radius: 20px;
    box-shadow: 5px 5px 0px #000000;
    cursor: pointer;
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .celebration-btn:hover {
    background: #059669; /* Emerald 600 */
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0px #000000;
  }

  .celebration-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px #000000;
  }

  /* Standard pop-in scaling animation */
  @keyframes rotateGlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Micro-animations */
  .animate-bounce-short {
    animation: bounceShort 2s ease infinite;
  }

  @keyframes bounceShort {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* Language toggle bindings */
  :global(.lang-khmer) .en-text,
  :global(.lang-khmer) .en-text-block {
    display: none !important;
  }
  
  :global(html:not(.lang-khmer)) .kh-text,
  :global(html:not(.lang-khmer)) .kh-text-block {
    display: none !important;
  }
</style>
