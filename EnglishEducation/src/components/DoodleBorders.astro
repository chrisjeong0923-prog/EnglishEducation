  <!-- Extra Crayon (Left) -->
  <div class="doodle-item pencil-float extra-doodle left-extra">
    <div class="doodle-inner scale-up-hover">
      <svg class="doodle-svg pencil-crayon" viewBox="0 0 100 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Happy Pencil Crayon">
        <path d="M 20 40 L 80 40 L 80 25 C 80 15, 20 15, 20 25 Z" fill="#34d399" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
        <rect x="20" y="40" width="60" height="12" fill="#cbd5e1" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
        <rect x="20" y="52" width="60" height="90" fill="#0ea5e9" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
