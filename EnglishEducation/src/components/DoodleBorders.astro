---
// DoodleBorders.astro - Large, parallax-scrolling interactive cartoon illustrations
---

<div class="doodle-frame-container">
  <!-- Left Margin Doodles (Standard, always visible on desktop) -->
  <!-- Baby Kouprey (Mascot) -->
  <div class="doodle-item dino-float">
    <div class="doodle-inner scale-up-hover">
      <svg class="doodle-svg baby-kouprey" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Cute Baby Kouprey">
