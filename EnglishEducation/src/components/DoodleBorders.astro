        <line x1="60" y1="52" x2="60" y2="142" stroke="#000" stroke-width="3"/>
        <path d="M 20 142 L 50 185 L 80 142 Z" fill="#fed7aa" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
        <path d="M 43 175 L 50 185 L 57 175 Z" fill="#000" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
        <circle cx="40" cy="90" r="5" fill="#000"/>
        <circle cx="60" cy="90" r="5" fill="#000"/>
        <path d="M 45 105 Q 50 112 55 105" stroke="#000" stroke-width="3.5" stroke-linecap="round" fill="none"/>
      </svg>
    </div>
  </div>

  <!-- Extra Star (Left) -->
  <div class="doodle-item star-float extra-doodle left-extra">
    <div class="doodle-inner scale-up-hover">
      <svg class="doodle-svg star-headphone" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Smiling Headphone Star">
        <path d="M 100 20 L 123 70 L 178 75 L 136 112 L 149 166 L 100 137 L 51 166 L 64 112 L 22 75 L 77 70 Z" fill="#c084fc" stroke="#000" stroke-width="4.5" stroke-linejoin="round"/>
        <path d="M 75 95 Q 85 85 90 95" stroke="#000" stroke-width="4" stroke-linecap="round" fill="none"/>
        <path d="M 110 95 Q 115 85 125 95" stroke="#000" stroke-width="4" stroke-linecap="round" fill="none"/>
        <path d="M 92 110 C 95 116, 105 116, 108 110" stroke="#000" stroke-width="4.5" stroke-linecap="round" fill="none"/>
        <path d="M 52 95 A 55 55 0 0 1 148 95" stroke="#fb7185" stroke-width="6.5" stroke-linecap="round" fill="none"/>
        <rect x="36" y="85" width="18" height="30" rx="9" fill="#fb7185" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
        <rect x="146" y="85" width="18" height="30" rx="9" fill="#fb7185" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>

  <!-- Extra Ball (Left) -->
  <div class="doodle-item ball-float extra-doodle left-extra">
    <div class="doodle-inner">
      <svg class="doodle-svg mini-ball" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="50" r="35" fill="#f43f5e" stroke="#000" stroke-width="3.5"/>
        <path d="M 50 15 C 30 25, 30 75, 50 85" fill="#38bdf8" stroke="#000" stroke-width="3"/>
        <path d="M 50 15 C 70 25, 70 75, 50 85" fill="#fbbf24" stroke="#000" stroke-width="3"/>
        <circle cx="50" cy="50" r="8" fill="#fff" stroke="#000" stroke-width="2.5"/>
      </svg>
    </div>
  </div>

  <!-- Extra Apple (Right) -->
  <div class="doodle-item apple-float extra-doodle right-extra">
    <div class="doodle-inner scale-up-hover">
      <svg class="doodle-svg study-apple" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Smart Study Apple">
        <path d="M 100 45 C 105 25, 115 20, 115 20" stroke="#78350f" stroke-width="5" stroke-linecap="round"/>
        <path d="M 105 32 C 120 22, 135 32, 120 40 C 112 36, 107 35, 105 32 Z" fill="#4ade80" stroke="#000" stroke-width="3" stroke-linejoin="round"/>
        <path d="M 100 55 C 50 45, 30 70, 30 110 C 30 155, 65 175, 100 165 C 135 175, 170 155, 170 110 C 170 70, 150 45, 100 55 Z" fill="#fb923c" stroke="#000" stroke-width="4.5" stroke-linejoin="round"/>
        <circle cx="70" cy="100" r="18" stroke="#000" stroke-width="5" fill="none"/>
        <circle cx="130" cy="100" r="18" stroke="#000" stroke-width="5" fill="none"/>
        <line x1="88" y1="100" x2="112" y2="100" stroke="#000" stroke-width="5"/>
        <path d="M 42 98 C 45 92, 50 92, 52 94" stroke="#000" stroke-width="4.5" fill="none"/>
        <path d="M 158 98 C 155 92, 150 92, 148 94" stroke="#000" stroke-width="4.5" fill="none"/>
        <circle cx="70" cy="100" r="5" fill="#000"/>
        <circle cx="130" cy="100" r="5" fill="#000"/>
        <path d="M 92 125 C 95 132, 105 132, 108 125" stroke="#000" stroke-width="4" stroke-linecap="round" fill="none"/>
        <circle cx="50" cy="120" r="6" fill="#fed7aa" opacity="0.8"/>
        <circle cx="150" cy="120" r="6" fill="#fed7aa" opacity="0.8"/>
      </svg>
    </div>
  </div>

  <!-- Extra Cloud (Right) -->
  <div class="doodle-item cloud-float extra-doodle right-extra">
    <div class="doodle-inner">
      <svg class="doodle-svg mini-cloud" viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M 30 50 C 15 50, 10 35, 25 25 C 20 10, 45 5, 55 15 C 65 0, 95 5, 95 25 C 110 25, 115 40, 100 50 Z" fill="#fff" stroke="#000" stroke-width="3.5" stroke-linejoin="round"/>
        <path d="M 45 35 Q 50 30 55 35" stroke="#000" stroke-width="2.5" stroke-linecap="round" fill="none"/>
        <path d="M 65 35 Q 70 30 75 35" stroke="#000" stroke-width="2.5" stroke-linecap="round" fill="none"/>
      </svg>
    </div>
  </div>

  <!-- Extra Book Monster (Right) -->
  <div class="doodle-item monster-float extra-doodle right-extra">
    <div class="doodle-inner scale-up-hover">
      <svg class="doodle-svg book-monster" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Happy Book Monster">
        <rect x="50" y="40" width="100" height="120" rx="14" fill="#a78bfa" stroke="#000" stroke-width="4.5" stroke-linejoin="round"/>
        <path d="M 60 160 L 60 170 C 60 174, 140 174, 140 170 L 140 160" fill="#f8fafc" stroke="#000" stroke-width="4.5" stroke-linejoin="round"/>
        <path d="M 54 163 L 54 169 C 54 171, 146 171, 146 169 L 146 163" fill="#cbd5e1" stroke="#000" stroke-width="2"/>
        <circle cx="82" cy="90" r="14" fill="#fff" stroke="#000" stroke-width="4"/>
        <circle cx="82" cy="90" r="6" fill="#000"/>
        <circle cx="79" cy="87" r="2.5" fill="#fff"/>
        <circle cx="118" cy="90" r="14" fill="#fff" stroke="#000" stroke-width="4"/>
        <circle cx="118" cy="90" r="6" fill="#000"/>
        <circle cx="115" cy="87" r="2.5" fill="#fff"/>
        <path d="M 90 115 C 90 128, 110 128, 110 115 Z" fill="#fca5a5" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
        <line x1="90" y1="115" x2="110" y2="115" stroke="#000" stroke-width="4"/>
        <path d="M 50 110 C 30 110, 20 95, 30 85" stroke="#000" stroke-width="4" stroke-linecap="round" fill="none"/>
        <path d="M 150 110 C 170 110, 180 95, 170 85" stroke="#000" stroke-width="4" stroke-linecap="round" fill="none"/>
        <path d="M 100 40 C 100 20, 120 15, 125 22" stroke="#f472b6" stroke-width="6" stroke-linecap="round" fill="none"/>
        <circle cx="125" cy="22" r="8" fill="#f472b6" stroke="#000" stroke-width="3"/>
      </svg>
    </div>
  </div>
</div>

<script>
  // Randomize positions of doodles within side margins to keep experience fresh per page load
  function randomizeDoodles() {
    if (typeof document === 'undefined' || !document.body) return;

    const docHeight = Math.max(
      document.body.scrollHeight || 0,
      document.documentElement.scrollHeight || 0,
      document.body.offsetHeight || 0,
      document.documentElement.offsetHeight || 0,
      document.body.clientHeight || 0,
      document.documentElement.clientHeight || 0
    ) || 1000;

    const leftDoodles = Array.from(document.querySelectorAll('.dino-float, .pencil-float, .ball-float, .star-float'));
    const rightDoodles = Array.from(document.querySelectorAll('.monster-float, .apple-float, .cloud-float'));

    const leftExtras = Array.from(document.querySelectorAll('.left-extra'));
    const rightExtras = Array.from(document.querySelectorAll('.right-extra'));

    const isLongPage = docHeight > 1350;

    // 1. Position Standard Left Doodles (always visible)
    const leftSlots = [125, 310, 500, 700];
    leftDoodles.forEach((item, index) => {
      const el = item as HTMLElement;
      const slot = leftSlots[index] || 150 + index * 180;
      const topOffset = slot + (Math.random() * 80 - 40);
      const leftOffset = 0.5 + Math.random() * 3;
      const rot = Math.random() * 44 - 22;
      const factor = (0.05 + Math.random() * 0.15).toFixed(2);

      el.style.top = `${topOffset}px`;
      el.style.left = `${leftOffset}%`;
      el.style.right = 'auto';
      el.style.setProperty('--scroll-factor', factor);

      const inner = el.querySelector('.doodle-inner') as HTMLElement;
      if (inner) inner.style.transform = `rotate(${rot}deg)`;
    });

    // 2. Position Standard Right Doodles (always visible)
    const rightSlots = [150, 330, 520];
    rightDoodles.forEach((item, index) => {
      const el = item as HTMLElement;
      const slot = rightSlots[index] || 150 + index * 180;
      const topOffset = slot + (Math.random() * 80 - 40);
      const rightOffset = 0.5 + Math.random() * 3;
      const rot = Math.random() * 44 - 22;
      const factor = (0.05 + Math.random() * 0.15).toFixed(2);

      el.style.top = `${topOffset}px`;
      el.style.right = `${rightOffset}%`;
      el.style.left = 'auto';
      el.style.setProperty('--scroll-factor', factor);

      const inner = el.querySelector('.doodle-inner') as HTMLElement;
      if (inner) inner.style.transform = `rotate(${rot}deg)`;
    });

    // 3. Position Left Extras (only if long page)
    const startYLeft = 900;
    const endY = docHeight - 250;
    const spacing = 220;

    leftExtras.forEach((item, index) => {
      const el = item as HTMLElement;
      const targetY = startYLeft + index * spacing;

      if (isLongPage && targetY < endY) {
        el.style.display = 'block';
        const topOffset = targetY + (Math.random() * 60 - 30);
        const leftOffset = 0.5 + Math.random() * 3;
        const rot = Math.random() * 40 - 20;
        const factor = (0.05 + Math.random() * 0.15).toFixed(2);

        el.style.top = `${topOffset}px`;
        el.style.left = `${leftOffset}%`;
        el.style.right = 'auto';
        el.style.setProperty('--scroll-factor', factor);

        const inner = el.querySelector('.doodle-inner') as HTMLElement;
        if (inner) inner.style.transform = `rotate(${rot}deg)`;
      } else {
        el.style.display = 'none';
      }
    });

    // 4. Position Right Extras (only if long page)
    const startYRight = 850;
    rightExtras.forEach((item, index) => {
      const el = item as HTMLElement;
      const targetY = startYRight + index * spacing;

      if (isLongPage && targetY < endY) {
        el.style.display = 'block';
        const topOffset = targetY + (Math.random() * 60 - 30);
        const rightOffset = 0.5 + Math.random() * 3;
        const rot = Math.random() * 40 - 20;
        const factor = (0.05 + Math.random() * 0.15).toFixed(2);

        el.style.top = `${topOffset}px`;
        el.style.right = `${rightOffset}%`;
        el.style.left = 'auto';
        el.style.setProperty('--scroll-factor', factor);

        const inner = el.querySelector('.doodle-inner') as HTMLElement;
        if (inner) inner.style.transform = `rotate(${rot}deg)`;
      } else {
        el.style.display = 'none';
      }
    });
  }

  // Track scroll position to update CSS variable for parallax scrolling
  let ticking = false;
  
  function updateScroll() {
    if (typeof document === 'undefined') return;
    const container = document.querySelector('.doodle-frame-container') as HTMLElement;
    if (container) {
      container.style.setProperty('--scroll-y', `${window.scrollY}px`);
    }
    ticking = false;
  }

  if (typeof window !== 'undefined') {
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScroll);
        ticking = true;
      }
    }, { passive: true });

    // Update layout if screen changes sizes or height changes (e.g. content loads)
    window.addEventListener('resize', randomizeDoodles);

    // Run on load
    window.addEventListener('DOMContentLoaded', randomizeDoodles);
    
    // Run immediately if DOM is already parsed
    if (document.body) {
      randomizeDoodles();
      updateScroll();
    }
    
    // Extra trigger after short delay to handle late content hydration layout shifts
    setTimeout(randomizeDoodles, 300);
  }
</script>

