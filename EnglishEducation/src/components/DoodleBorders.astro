        <circle cx="75" cy="105" r="16" fill="#fff" stroke="#000" stroke-width="4"/>
        <circle cx="75" cy="105" r="7" fill="#000"/>
        <circle cx="71" cy="101" r="3.5" fill="#fff"/>
        <circle cx="125" cy="105" r="16" fill="#fff" stroke="#000" stroke-width="4"/>
        <circle cx="125" cy="105" r="7" fill="#000"/>
        <circle cx="121" cy="101" r="3.5" fill="#fff"/>
