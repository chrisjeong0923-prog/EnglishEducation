        <path d="M 52 95 A 55 55 0 0 1 148 95" stroke="#ec4899" stroke-width="6.5" stroke-linecap="round" fill="none"/>
        <rect x="36" y="85" width="18" height="30" rx="9" fill="#ec4899" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
